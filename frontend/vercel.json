{
  "headers": [
    {
      "source": "/downloads/allclear-app.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"allclear-app.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!downloads/).*)",
      "destination": "/index.html"
    }
  ]
}
